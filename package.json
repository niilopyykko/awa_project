{
  "name": "10-full-stack",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "server:prod": "npm run start --prefix server",
    "client:prod": "npm run start --prefix client",
    "start": "concurrently \"npm run server:prod\" \"npm run client:prod\"",
    "update:all": "cd client && npx ncu -u && npm install && cd ../server && npx ncu -u && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19"
  }
}
