## Example environment variables for server
# Copy this file to `server/.env` and update values before running the server.

# Secret used to sign JWT tokens (use a long, random value in production)
SECRET=replace_with_a_long_random_secret
#1234567890qwerty

# Port the server listens on
PORT=3001

# Flag to disable registration if application is exposed to the world
DISABLE_REGISTRATION=true

# Mongo db address // if not present, code has fallback
MONGO_URI=mongodb://127.0.0.1:27017/awa

# Full server URL used when generating read-only links and for CORS defaults
# Example: http://localhost:3001 or https://api.example.com
SERVER_URL=http://localhost:3001

# Client origin (frontend) that the server should allow for CORS
# Example: http://localhost:3000 or https://app.example.com
CLIENT_URL=http://localhost:3000
