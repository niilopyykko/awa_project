# ---------- Server Configuration ----------
PORT=3001
SECRET=YOUR_JWT_SECRET_HERE
DISABLE_REGISTRATION=false
SERVER_URL=http://awa_backend:3001
CLIENT_URL=http://awa_frontend:3000
# Public URL clients should use for read-only links (e.g., https://your-domain)
PUBLIC_SERVER_URL=

# ---------- MongoDB ----------
# Replace with your MongoDB credentials. DO NOT put real passwords here!
MONGO_INITDB_ROOT_USERNAME=YOUR_MONGO_USER
MONGO_INITDB_ROOT_PASSWORD=YOUR_MONGO_PASSWORD
MONGO_DB=awa_db
MONGO_URI=mongodb://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@awa_mongo:27017/awa_db?authSource=admin
