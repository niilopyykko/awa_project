# ---------- Backend ----------
PORT=3001
SECRET=dev_secret_key
DISABLE_REGISTRATION=false

# Backend internal URL (used ONLY by frontend proxy)
SERVER_URL=http://awa_backend:3001

# Public frontend URL (used for share links)
FRONTEND_URL=http://awa_frontend:3000

# ---------- Cookies ----------
# In Docker you typically run behind a reverse proxy (HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---------- MongoDB ----------
MONGO_URI=mongodb://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@awa_mongo:27017/awa_db?authSource=admin
